{
  "name": "ballance-contest-console",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "workspaces": [
    "packages/contracts",
    "packages/core",
    "packages/testkit",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build -w @ballance/contracts && npm run build -w @ballance/core && npm run build -w @ballance/testkit && npm run build -w @ballance/server && npm run build -w @ballance/web",
    "dev": "node scripts/dev.mjs",
    "typecheck": "npm run build -w @ballance/contracts && npm run build -w @ballance/core && npm run build -w @ballance/testkit && npm run typecheck -w @ballance/server && npm run typecheck -w @ballance/web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-Portable.ps1",
    "test:mock-client": "npm run build -w @ballance/server && node scripts/Test-MockClientPipe.mjs",
    "test:live-probe-helpers": "npm run build -w @ballance/server && node scripts/Test-LiveWorkMode.mjs --self-test",
    "test:live-work": "npm run test:live-probes",
    "test:live-probes": "npm run build -w @ballance/server && node scripts/Test-LiveWorkMode.mjs --require-dual",
    "package:portable": "node scripts/build-portable.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "acorn": "^8.0.0",
    "ajv": "^8.17.0",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^9.0.0",
    "cookie": "^1.1.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^26.0.0",
    "lru-cache": "^11.0.0",
    "minimatch": "^10.2.0",
    "process-warning": "^4.0.0",
    "real-require": "^1.0.0",
    "semver": "^7.0.0",
    "set-cookie-parser": "^2.7.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  }
}
